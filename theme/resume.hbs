<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, user-scalable=no, minimal-ui">

    <title>{{#resume.basics}}{{name}}{{/resume.basics}}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flexboxgrid/6.3.1/flexboxgrid.min.css" type="text/css">

    <style>
    {{{css}}}
    </style>
</head>

<body>
<div id="resume">
{{#resume.basics}}
    <div class="header">
        <div class="fullname">
            <h1>{{name}}</h1>
        </div>
        <h2 class="label">{{label}}</h2>
        <div class="contact">
        {{#if website}}
            <div class="website">
                <a href="{{website}}">{{website}}</a>
            </div>
        {{/if}}
        {{#if email}}
            <div class="contact-details">
            {{#if phone}}
                <span class="email">
                    <a href="mailto:{{email}}">{{email}}</a>
                </span>
            {{/if}}
            {{#if phone}}
                <span class="phone">
                    • {{phone}}
                </span>
            {{/if}}
            </div>
        {{/if}}

        {{#if profiles.length}}
            <div class="profile-details">
            {{#each profiles}}
                <span class="profile">
                    <a href="{{url}}" target="_blank">{{urlRender}}</a>
                </span>
                {{#unless @last}}
                    <span class="separator">•</span>
                {{/unless}}
            {{/each}}
            </div>
        {{/if}}
        </div>
    </div>
{{/resume.basics}}

    <div class="resume-wrapper">
    {{#resume.basics}}
        <div class="row">
            <div class="col-xs-12">
                <section id="basics">
                {{#if summary}}
                    <div class="summary">
                        <p>{{summary}}</p>
                    </div>
                {{/if}}
                </section>
            </div>
        </div>
    {{/resume.basics}}

        <div class="row content">
            <div class="col-xs-12">

            {{#if resume.skills.length}}
                <section id="skills">
                    <h2>Skills</h2>
                    {{#each resume.skills}}
                        <div class="item">
                        {{#if name}}
                            <span class="name">
                                {{name}}{{#if keywords.length}}<span style="font-weight: normal">:</span>{{/if}}
                            </span>
                        {{/if}}
                        {{#if keywords.length}}
                            <span class="keywords">
                            {{#each keywords}}
                                <span>{{.}}</span>
                            {{/each}}
                            </span>
                        {{/if}}
                        </div>
                    {{/each}}
                </section>
            {{/if}}

            {{#if resume.work.length}}
                <section id="work">
                    <h2>Work Experience</h2>
                    {{#each resume.work}}
                        <div class="item">
                            <div class="row">
                                <div class="description col-xs-8">
                                {{#if position}}
                                    <span class="position">
                                        {{position}}
                                    </span>
                                {{/if}}
                                {{#if name}}
                                    <span class="name">
                                        {{name}}
                                    </span>
                                {{/if}}
                                {{#if location}}
                                    <div class="location">
                                        {{location}}
                                    </div>
                                {{/if}}
                                </div>
                                <div class="description col-xs-4">
                                    <div class="date">
                                    {{#if startDate}}
                                        <span class="startDate">
                                            {{startDate}}
                                        </span>
                                    {{/if}}
                                        <span class="endDate">
                                        {{#if endDate}}
                                            • {{endDate}}
                                        {{else}}
                                            • Now
                                        {{/if}}
                                        </span>
                                    </div>
                                {{#if url}}
                                    <div class="website">
                                        <a href="{{url}}" target="_blank">{{urlRender}}</a>
                                    </div>
                                {{/if}}
                                </div>
                            </div>
                            <div class="row">
                                <div class="infos col-xs-12">
                                    <div class="description">
                                    {{#if summary}}
                                        <div class="summary">
                                            <p>{{summary}}</p>
                                        </div>
                                    {{/if}}
                                    {{#if highlights.length}}
                                        <ul class="highlights">
                                        {{#each highlights}}
                                            <li>{{{.}}}</li>
                                        {{/each}}
                                        </ul>
                                    {{/if}}
                                    </div>
                                </div>
                            </div>
                        </div>
                    {{/each}}
                </section>
            {{/if}}

            {{#if resume.certificates.length}}
                <section id="certificates">
                    <h2>Patents</h2>
                    {{#each resume.certificates}}
                        <div class="item">
                            <div class="row">
                                <div class="description col-xs-8">
                                {{#if name}}
                                    <span class="name">
                                        {{name}}
                                    </span>
                                {{/if}}
                                </div>
                                <div class="description col-xs-4">
                                {{#if date}}
                                    <div class="date">
                                        {{date}}
                                    </div>
                                {{/if}}
                                </div>
                                <div class="description col-xs-9">
                                {{#if summary}}
                                    <span class="summary">
                                        {{summary}}
                                    </span>
                                {{/if}}
                                </div>
                                <div class="description col-xs-3">
                                {{#if url}}
                                    <div class="website">
                                        <a href="{{url}}" target="_blank">{{issuer}}</a>
                                    </div>
                                {{else}}
                                    {{#if website}}
                                        <div class="website">
                                            <a href="{{website}}" target="_blank">{{publisher}}</a>
                                        </div>
                                    {{/if}}
                                {{/if}}
                                </div>
                            </div>
                        </div>
                    {{/each}}
                </section>
            {{/if}}

            {{#if resume.publications.length}}
                <section id="publications">
                    <h2>Selected Writing</h2>
                    {{#each resume.publications}}
                        <div class="item">
                            <div class="row">
                                <div class="description col-xs-8">
                                {{#if name}}
                                    <span class="name">
                                        {{name}}
                                    </span>
                                {{/if}}
                                </div>
                                <div class="description col-xs-4">
                                {{#if releaseDate}}
                                    <div class="date">
                                        {{releaseDate}}
                                    </div>
                                {{/if}}
                                </div>
                                <div class="description col-xs-9">
                                {{#if summary}}
                                    <span class="summary">
                                        {{summary}}
                                    </span>
                                {{/if}}
                                </div>
                                <div class="description col-xs-3">
                                {{#if url}}
                                    <div class="website">
                                        <a href="{{url}}" target="_blank">{{publisher}}</a>
                                    </div>
                                {{else}}
                                    {{#if website}}
                                        <div class="website">
                                            <a href="{{website}}" target="_blank">{{publisher}}</a>
                                        </div>
                                    {{/if}}
                                {{/if}}
                                </div>
                            </div>
                        </div>
                    {{/each}}
                </section>
            {{/if}}

            {{#if resume.projects.length}}
                <section id="projects">
                    <h2>Open Source Projects</h2>
                    {{#each resume.projects}}
                        <div class="item">
                            <div class="row">
                                <div class="description col-xs-8">
                                {{#if name}}
                                    <span class="name">
                                        {{name}}
                                    </span>
                                {{/if}}
                                </div>
                                <div class="description col-xs-4">
                                    <div class="date">
                                    {{#if startDate}}
                                        <span class="startDate">
                                            {{startDate}}
                                        </span>
                                    {{/if}}
                                        <span class="endDate">
                                        {{#if endDate}}
                                            • {{endDate}}
                                        {{else}}
                                            • Now
                                        {{/if}}
                                        </span>
                                    </div>
                                </div>
                                <div class="description col-xs-7">
                                {{#if summary}}
                                    <span class="summary">
                                        {{summary}}
                                    </span>
                                {{/if}}
                                </div>
                                <div class="description col-xs-5">
                                {{#if url}}
                                    <div class="website">
                                        <a href="{{url}}" target="_blank">{{urlRender}}</a>
                                    </div>
                                {{/if}}
                                </div>
                                <div class="infos col-xs-12">
                                    <div class="description">
                                    {{#if highlights.length}}
                                        <ul class="highlights">
                                        {{#each highlights}}
                                            <li>{{.}}</li>
                                        {{/each}}
                                        </ul>
                                    {{/if}}
                                    </div>
                                </div>
                            </div>
                        </div>
                    {{/each}}
                </section>
            {{/if}}

            {{#if resume.education.length}}
                <section id="education">
                    <h2>Education</h2>
                    {{#each resume.education}}
                        <div class="item">
                            <div class="row">
                                <div class="col-xs-8">
                                {{#if institution}}
                                    <div class="institution">
                                        {{institution}}
                                    </div>
                                {{/if}}
                                </div>
                                <div class="col-xs-4">
                                    <div class="date">
                                    {{#if startDate}}
                                        <span class="startDate">
                                            {{startDate}}
                                        </span>
                                    {{/if}}
                                        <span class="endDate">
                                        {{#if endDate}}
                                            • {{endDate}}
                                        {{else}}
                                            • Now
                                        {{/if}}
                                        </span>
                                    </div>
                                </div>
                                <div class="description col-xs-8">
                                {{#if studyType}}
                                    <span class="studyType">
                                        {{studyType}}
                                    </span>
                                {{/if}}
                                {{#if area}}
                                    <span class="area">
                                        {{area}}
                                    </span>
                                {{/if}}
                                </div>
                            </div>
                            <div class="row">
                            {{#if gpa}}
                                <div class="gpa">
                                    GPA: {{gpa}}
                                </div>
                            {{/if}}
                            {{#if courses.length}}
                                <ul class="courses">
                                {{#each courses}}
                                    <li>{{.}}</li>
                                {{/each}}
                                </ul>
                            {{/if}}
                            </div>
                        </div>
                    {{/each}}
                </section>
            {{/if}}

            </div>
        </div>
    </div>
</div>
</body>
</html>
